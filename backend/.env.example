# Copy to backend/.env and fill in your own values. Never commit the real .env.

# Your own MongoDB connection string. The app will not start without it.
# Local:  mongodb://127.0.0.1:27017/admission_system
# Atlas:  mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/admission_system?retryWrites=true&w=majority
MONGODB_URI=

# Long random string used to sign auth tokens.
JWT_SECRET=

PORT=3001

# Origin of the deployed frontend, for CORS. Localhost is always allowed.
# FRONTEND_ORIGIN=https://your-frontend.vercel.app
# EXTRA_ORIGINS=https://another-allowed-origin

# Credentials for the auto-seeded admin account. Set these before deploying anywhere
# reachable; otherwise the seed falls back to admin@university.edu / admin123.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Only if your local resolver cannot reach MongoDB Atlas. Leave unset on Vercel.
# DNS_SERVERS=8.8.8.8,1.1.1.1
