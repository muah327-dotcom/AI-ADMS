# Dependencies
node_modules/

# Secrets. backend/.env.example is the committed template; the real .env never is.
.env
.env.local
.env.*.local

# Build output — regenerated by `npm run build`. Committing it makes every build
# show up as a diff and creates merge conflicts for no reason.
frontend/dist/
dist/
build/

# Real identity documents used to test OCR. These are other people's CNICs and
# board certificates and must never reach a repository.
samples/
test-documents/
*.jpeg
*.jpg
!frontend/public/*.png
!frontend/src/**/*.png

# OCR engine assets (~40 MB). tesseract.js fetches these at runtime; a committed
# copy is dead weight.
*.traineddata
*.traineddata.gz
tesseract-core*.wasm
tesseract-core*.wasm.js

# Local OCR test scaffolding, not part of the application
ocr-harness/
ocr-tester-site/

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Uploads written at runtime
uploads/

# Editor and OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Coursework paperwork — kept with the project locally, not in the repository
*.pdf
proposal_text.txt
status.txt
